  user          User?        @relation(fields: [userId], references: [id])
  userId        Int
  company       Company?     @relation(fields: [companyId], references: [id])
  companyId     Int
  customerId    Int
  // TODO: CUSTOMER RELATIONSHIP
  replyTo       Int
  reply         Chat         @relation("Replies", fields: [replyTo], references: [id])
  replies       Chat[]       @relation("Replies")
  message       String
  images        Json
  readStatus    Json
}

model Companyadmin {
  id            Int      @id @default(autoincrement())
  alternativeId String   @default(cuid())
  company       Company? @relation(fields: [companyId], references: [id])
