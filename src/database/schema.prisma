model CompanyCard {
  id              Int      @id @default(autoincrement())
  alternativeId   String?  @unique
  ending          String?
  expirationMonth String?
  expirationYear  String?
  cardType        String?
  name            String?
  token           String?
  cardStripeId    String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  companyId       Int      @unique
  company         Company  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CompanyLocation {
  id                        Int                @id @default(autoincrement())
  alternativeId             String?            @unique
  name                      String?
  isActive                  Boolean            @default(true)
  isMainLocation            Boolean            @default(true)
  contactName               String
  info                      Json
  address                   Json
  isAddressAsBillingAddress Boolean            @default(false)
  billingAddress            Json
  contact                   Json
  companyId                 Int
  company                   Company            @relation(fields: [companyId], references: [id])
  // TODO: workTypes: [{ type: Schema.Types.ObjectId, ref: 'WorkType' }],
  // assignedVendors: [AssignedVendorSchema],
  assignedEmployees         AssignedEmployee[]
  poRequestEmailSender      String
  jobs                      Job[]
  servicetickets            Servicetickets[]
  jobrequest                Jobrequest[]
  invoice                   Invoice[]
  advancepayments           Advancepayment[]
  paymentcustomers          Paymentcustomer[]

  @@index([companyId, isActive, isMainLocation])
  @@index([companyId, isActive, isMainLocation, id])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailDefault {
  id            Int      @id @default(autoincrement())
  alternativeId String?  @unique
  subject       String?
  message       String
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  updatedBy     Int?
  user          User?    @relation(fields: [updatedBy], references: [id])
  emailType     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, emailType])
}

model EmailSchedule {
  id            Int     @id @default(autoincrement())
  alternativeId String? @unique
  userId        Int
  user          User    @relation(fields: [userId], references: [id])
  type          Int     @default(0)
  jobs          Job[]
  pulled        Boolean @default(false)

  @@index([pulled])
}

model Industry {
  id            Int     @id @default(autoincrement())
  alternativeId String? @unique
  title         String
  createdBy     Int
  user          User    @relation(fields: [createdBy], references: [id])

  companyInfo CompanyInfo[]
  jobTypes    JobType[]

  @@index([title])
}

model JobTaskJobType {
  id                   Int       @id @default(autoincrement())
  jobTypeId            Int?
  jobType              JobType?  @relation(fields: [jobTypeId], references: [id])
  isSelfFinished       Boolean?  @default(false)
  status               Int?      @default(0)
  charges              Float?    @default(0.0)
  startTime            DateTime?
  tempStartTime        DateTime?
  endTime              DateTime?
  timeSpent            Int?      @default(0)
  pausedCount          Int?      @default(0)
  timeUpdatedById      Int?
  timeUpdatedBy        User?     @relation(fields: [timeUpdatedById], references: [id])
  timeUpdatedAt        DateTime?
  equipmentScanned     Boolean?  @default(false)
  noOfEquipmentScanned Int?      @default(0)
  quantity             Int?      @default(0)
  price                Float?
  completedCount       Int?
  completedComment     String?
  jobCostingQuantity   Int?
  JobTask              JobTask?  @relation(fields: [jobTaskId], references: [id])
  jobTaskId            Int?
}

model JobTask {
  id                         Int              @id @default(autoincrement())
  status                     Int?             @default(0)
  employeeType               Boolean?         @default(false)
  technicianId               Int?
  technician                 User?            @relation(fields: [technicianId], references: [id])
  contractorId               Int?
  contractor                 Company?         @relation(fields: [contractorId], references: [id])
  contractorCommissionTierId Int?
  // TODO: ref JobCosting
  comment                    String?
  jobTypes                   JobTaskJobType[]
  paid                       Boolean?         @default(false)
  paidAt                     DateTime?
  Job                        Job?             @relation(fields: [jobId], references: [id])
  jobId                      Int?
}

model JobTrack {
  id     Int      @id @default(autoincrement())
  userId Int?
  user   User?    @relation(fields: [userId], references: [id])
  action String?
  note   String?
  date   DateTime @default(now())
  Job    Job?     @relation(fields: [jobId], references: [id])
  jobId  Int?
}

model JobImage {
  id           Int      @id @default(autoincrement())
  imageUrl     String
  uploadedById Int
  user         User     @relation(fields: [uploadedById], references: [id])
  createAt     DateTime @default(now())
  Job          Job?     @relation(fields: [jobId], references: [id])
  jobId        Int?
}

model JobTechnicianImage {
  id           Int      @id @default(autoincrement())
  imageUrl     String?
  uploadedById Int
  user         User     @relation(fields: [uploadedById], references: [id])
  createAt     DateTime @default(now())
  Job          Job?     @relation(fields: [jobId], references: [id])
  jobId        Int?
}

model Job {
  id                 Int                  @id @default(autoincrement())
  alternativeId      String?              @unique
  scheduleTimeAMPM   Int?                 @default(0)
  scheduleDate       DateTime?
  scheduledStartTime DateTime?
  scheduledEndTime   DateTime?
  jobId              String?
  parentJobId        Int?                 @unique
  parentJob          Job?                 @relation("JobParent", fields: [parentJobId], references: [id])
  childrenJob        Job[]                @relation("JobParent")
  ticketId           Int?
  // TODO: ref ServiceTicket
  requestId          Int?
  // TODO: ref JobRequest
  equipmentId        Int?
  // TODO: ref CustomerEquiment
  technicianId       Int?
  technician         User?                @relation(fields: [technicianId], references: [id])
  contractorId       Int?
  contractor         Company?             @relation("jobContractor", fields: [contractorId], references: [id])
  customerId         Int?
  // TODO: ref Customer
  jobLocationId      Int?
  // TODO: ref JobLocation
  jobSiteId          Int?
  // TODO: ref JobSite
  isHomeOccupied     Boolean?             @default(false)
  homeOwnerId        Int?
  // TODO: ref HomeOwner
  homeJobLocationId  Int?
  // TODO: ref JobLocation
  homeJobSiteId      Int?
  // TODO: ref JobLocation
  customerContactId  Int?
  // TODO: ref Contact
  customerPO         String?
  image              String?
  images             JobImage[]
  technicianImages   JobTechnicianImage[]

  typeId              Int?
  type                JobType?         @relation(fields: [typeId], references: [id])
  tasksBackup         Json?
  tasks               JobTask[]
  companyId           Int?
  company             Company?         @relation("jobCompany", fields: [companyId], references: [id])
  description         String?
  status              Int?             @default(0)
  track               JobTrack[]
  comment             String?
  createdAt           DateTime?        @default(now())
  createdById         Int?
  createdBy           User?            @relation("jobCreatedBy", fields: [createdById], references: [id])
  updatedAt           DateTime?        @updatedAt
  employeeType        Boolean?         @default(false)
  charges             Int?             @default(0)
  salesTaxId          Int?
  salesTax            SaleTax?         @relation(fields: [salesTaxId], references: [id])
  startTime           DateTime?
  endTime             DateTime?
  timeSpent           Int?             @default(0)
  timeUpdatedById     Int?
  timeUpdatedBy       User?            @relation("jobTimeUpdatedBy", fields: [timeUpdatedById], references: [id])
  timeUpdatedAt       DateTime?
  equipmentScanned    Boolean?         @default(false)
  noOfEquimentScanned Int?             @default(0)
  completeOnTime      Boolean?         @default(false)
  commissionId        Int?
  // TODO: ref JobCommission
  workTypeId          Int?
  // TODO: ref WorkType
  companyLocationId   Int?
  companyLocation     CompanyLocation? @relation(fields: [companyLocationId], references: [id])

  commissionHistories CommissionHistory[]
  emailSchedules      EmailSchedule[]

  jobrequest     Jobrequest[]
  invoice        Invoice[]
  paymentvendors Paymentvendor[]

  @@index([employeeType])
  @@index([image])
}

model JobCharges {
  id            Int      @id @default(autoincrement())
  alternativeId String?  @unique
  charges       Int?
  isFixed       Boolean  @default(true)
  jobTypeId     Int
  jobType       JobType  @relation(fields: [jobTypeId], references: [id])
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  createdBy     Int
  user          User     @relation(fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())
  salesTaxId    Int
  salesTax      SaleTax  @relation(fields: [salesTaxId], references: [id])
}

model JobCosting {
  id            Int      @id @default(autoincrement())
  alternativeId String?  @unique
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  isActive      Boolean  @default(true)
  inactiveById  Int?
  inactiveBy    User?    @relation(fields: [inactiveById], references: [id])
  inactiveAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model JobType {
  id            Int       @id @default(autoincrement())
  alternativeId String?   @unique
  title         String
  description   String?
  sku           String?
  industryId    Int?
  industry      Industry? @relation(fields: [industryId], references: [id])
  createdBy     Int?
  user          User?     @relation(fields: [createdBy], references: [id])
  isActive      Boolean   @default(true)
  quickbookId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobTaskJobTypes JobTaskJobType[]
  jobs            Job[]
  jobCharges      JobCharges[]

  servicetickets     Servicetickets[]
  serviceTicketTasks ServiceTicketTasks[]

  @@index([title], type: SpGist)
  @@index([createdBy, quickbookId])
  @@index([title, industryId, createdBy])
  @@index([createdBy, industryId, isActive])
}

model PriceTier {
  id            Int      @id @default(autoincrement())
  alternativeId String?  @unique
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  isActive      Boolean  @default(true)
  inactiveById  Int?
  inactiveBy    User?    @relation(fields: [inactiveById], references: [id])
  inactiveAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SaleTax {
  id            Int      @id @default(autoincrement())
  alternativeId String?  @unique
  state         String?
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id])
  createdBy     Int
  user          User     @relation(fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())

  jobCharges JobCharges[]
  jobs       Job[]
}

model Session {
  id            Int      @id @default(autoincrement())
  alternativeId String?  @unique
  session       String
  expires       DateTime

  @@index([session])
}

model UserAuth {
  id                   Int      @id @default(autoincrement())
  email                String   @unique
  password             String
  resetPasswordToken   String
  resetPasswordExpires DateTime
  socialId             String
  connectorType        Int      @default(0)
  User                 User?

  @@index([email])
  @@index([socialId, connectorType])
}

model User {
  id               Int       @id @default(autoincrement())
  alternativeId    String?   @unique
  accountType      Int?
  auth             UserAuth? @relation(fields: [userAuthId], references: [id])
  userAuthId       Int?      @unique
  profile          Json?
  address          Json?
  location         Json?
  contact          Json?
  permissions      Json?
  emailPreferences Json?
  // TODO: Contats need to be implemented
  balance          Int       @default(0)
  credit           Int       @default(0)
  commission       Int?
  firebaseTokens   Json
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  companyBlockchainsVerified    CompanyBlockchain[]      @relation("CompanyBlockchainVerifiedBy")
  companyBlockchainsdenied      CompanyBlockchain[]      @relation("CompanyBlockchainDeniedBy")
  industriesCreated             Industry[]
  jobCostingsInactivated        JobCosting[]
  priceTiersInactivated         PriceTier[]
  jobTypesCreated               JobType[]
  jobstimeUpdated               Job[]                    @relation("jobTimeUpdatedBy")
  jobsCreated                   Job[]                    @relation("jobCreatedBy")
  jobTracks                     JobTrack[]
  jobs                          Job[]
  jobTechnicianImages           JobTechnicianImage[]
  jobImages                     JobImage[]
  jobTasks                      JobTask[]
  jobTasksJobTypesTimeUpdated   JobTaskJobType[]
  technicianCommissionHistories CommissionHistory[]      @relation("commissionHistoryTechnician")
  editedCommissionHistories     CommissionHistory[]      @relation("commissionHistoryEditedBy")
  createdAdvancePayment         Advancepayment[]         @relation("advancePaymentUserCreatedBy")
  updatedAdvancePayment         Advancepayment[]         @relation("advancePaymentUserUpdatedBy")
  voidedAdvancePayment          Advancepayment[]         @relation("advancePaymentUserVoidedBy")
  advancepaymentemployee        Advancepaymentemployee[]
  chat                          Chat[]
  createdServiceTicket          Servicetickets[]         @relation("serviceTicketUserCreatedBy")
  technicianServiceTicket       Servicetickets[]         @relation("serviceTicketUsertechnician")
  editedServiceTicket           Servicetickets[]         @relation("serviceTicketUsereditedBy")
  joblocation                   Joblocation[]
  createdJobRequest             Jobrequest[]             @relation("jobRequestUserCreatedBy")
  editedJobRequest              Jobrequest[]             @relation("jobRequestUsereditedBy")
  invoice                       Invoice[]
  paymentterm                   Paymentterm[]
  emaildefaultsUpdated          EmailDefault[]
  jobChargesCreated             JobCharges[]
  saleTaxesCreated              SaleTax[]
  emailSchedules                EmailSchedule[]
  createdPayment                Payment[]                @relation("paymentUserCreatedBy")
  updatedPayment                Payment[]                @relation("paymentUserupdatedBy")
  paymentemployee               Paymentemployee[]
}
