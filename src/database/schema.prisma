  employee      User?  @relation(fields: [employeeId], references: [id])
  employeeId    Int?
}

model Assignedvendor {
  id            Int     @id @default(autoincrement())
  alternativeId String  @default(cuid())
  vendor        Company @relation(fields: [vendorId], references: [id])
  vendorId      Int
  workTypes     Json
}

enum ChatChannels {
  serviceTicket
  jobRequest
  job
}

model Chat {
  id            Int          @id @default(autoincrement())
  alternativeId String       @default(cuid())
