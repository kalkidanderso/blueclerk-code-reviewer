model Companyadmin {
    id            Int      @id @default(autoincrement())
    alternativeId String   @default(cuid())
    company       Company? @relation(fields: [companyId], references: [id])
    companyId     Int
}

model Supplieradmin {
    id            Int    @id @default(autoincrement())
    alternativeId String @default(cuid())
    supplier      Int
    // TODO: SUPPLIER RELATIONSHIP
}
