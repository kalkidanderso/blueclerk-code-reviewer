enum InvoiceStatus {
    UNPAID
    PARTIALLY_PAID
    PAID
}

model Invoice {
    id                  Int           @id @default(autoincrement())
    alternativeId       String        @default(cuid())
    invoiceId           String
    invoiceType         Int           @default(0)
    jobId               Int?
    // TODO: JOB RELATIONSHIP
    purchaseOrderId     Int?
    // TODO: PURCHASEORDER RELATIONSHIP
    estimateId          Int?
    // TODO: ESTIMATE RELATIONSHIP
    jobPurchaseOrdersId Int?
    // TODO: JOBPURCHASEORDER RELATIONSHIP
    issuedDate          DateTime
    dueDate             DateTime
    isDraft             Boolean       @default(false)
    paymentTermId       Int
    // TODO: PAYMENTTERM RELATIONSHIP
    note                String?
    customerPO          String
    customerContactId   Int
    //TODO: CONTACT RELATIONSHIP
    vendorId            String
    customerId          Int
    // TODO: CUSTOMER RELATIONSHIP
    jobLocation         Joblocation   @relation(fields: [jobLocationId], references: [id])
    jobLocationId       Int
    jobSite             Jobsite       @relation(fields: [jobSiteId], references: [id])
    jobSiteId           Int
    companyId           Int
    // TODO: COMPANY RELATIONSHIP
    charges             Int           @default(0)
    taxAmount           Int           @default(0)
    subTotal            Int           @default(0)
    total               Int           @default(0)
    shippingCost        Int           @default(0)
    tax                 Int
    taxPercentage       Int
    createdById         Int
    // TODO: USER RELATIONSHIP
    timeSpent           Int           @default(0)
    items               Json?
    paymentApplied      Int           @default(0)
    balanceDue          Int
    paid                Boolean       @default(false)
    serviceType         InvoiceStatus @default(UNPAID)
    emailHistory        Json
    bouncedEmailFlag    Boolean       @default(false)
    lastEmailSent       DateTime
    quickbookId         String
    commissionId        Int?
    // TODO:COMMISSION RELATIONSHIP
    isVoid              Boolean       @default(false)
    workTypeId          Int
    // TODO: WORKTYPE RELATIONSHIP
    companyLocationId   Int
    // TODO: COMPANYLOCATION RELATIONSHIP
    technicianMessages  Json
    showJobId           Boolean       @default(true)
    createdAt           DateTime      @default(now())
    updatedAt           DateTime      @updatedAt

    @@index([customerPO])
    @@index([vendorId])
    @@index([customerContactId])
    @@index([isDraft])
    @@index([issuedDate, isDraft])
    @@index([isVoid])
    @@index([quickbookId, isDraft, isVoid])
    @@index([createdAt, id, isDraft, isVoid])
    @@index([issuedDate, note, vendorId, invoiceId])
    @@index([createdAt, isDraft, isVoid, invoiceId, customerPO, vendorId])
}
